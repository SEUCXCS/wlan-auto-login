<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>@APP_ID@</string>
    <key>BundleProgram</key><string>Contents/MacOS/@APP_NAME@</string>
    <key>ProgramArguments</key><array>
        <string>@APP_NAME@</string><string>--system</string><string>service</string><string>run</string>
    </array>
    <key>AssociatedBundleIdentifiers</key><array><string>@APP_ID@</string></array>
    <key>EnvironmentVariables</key><dict><key>WLANLOGIN_MANAGED</key><string>1</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>30</integer>
</dict></plist>
